{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "next-env.d.ts",
    "cloudflare-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/*.tsx",
    "lib/*.ts",
    "db/*.ts",
    "tests/*.ts",
    "tests/*.mts",
    "worker/*.ts",
    "vite.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "dist",
    ".vinext",
    ".wrangler",
    ".sites-runtime",
    "outputs",
    "work"
  ]
}
